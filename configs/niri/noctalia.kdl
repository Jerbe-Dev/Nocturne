layout {

    focus-ring {
        active-color   "#ffffff"
        inactive-color "#404040"
        urgent-color   "#b0b0b0"
    }

    border {
        active-color   "#ffffff"
        inactive-color "#404040"
        urgent-color   "#b0b0b0"
    }

    tab-indicator {
        active-color   "#ffffff"
        inactive-color "#404040"
        urgent-color   "#b0b0b0"
    }

    insert-hint {
        color "#ffffff80"
    }
}

recent-windows {
    highlight {
        active-color "#ffffff"
        urgent-color "#b0b0b0"
    }
}
