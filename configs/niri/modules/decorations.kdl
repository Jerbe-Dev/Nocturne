// Keep compositor effects light for integrated graphics and low-memory systems.
// Blur is intentionally disabled; it adds GPU work without improving responsiveness.

// Recent Windows (Alt+Tab)
recent-windows {
    highlight {
        active-color "#999999ff"
        urgent-color "#ff9999ff"
        padding 24
        corner-radius 8
    }

    previews {
        max-height 360
        max-scale 0.4
    }

    binds {
      Alt+Tab { next-window scope="workspace"; }
    }
}
